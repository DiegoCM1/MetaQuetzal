EXPO_PUBLIC_MIXPANEL_PROJECT_TOKEN=EXPO_PUBLIC_MIXPANEL_PROJECT_TOKEN                                                       

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID"

# Backend target for LOCAL dev (npx expo start).
#   - Frontend-only work: use staging (below) — no local backend needed.
#   - Editing backend code: use your laptop LAN IP, e.g. http://192.168.x.x:8000 (uvicorn --host 0.0.0.0). (On MAC Run: ipconfig getifaddr en0)  (On Windows run: ipconfig)
#   - NEVER point local dev at production.
EXPO_PUBLIC_API_URL="URL_STAGING_OR_LOCAL_LAN_IP_BACKEND_HOST"

EXPO_PUBLIC_SENTRY_DSN="EXPO_PUBLIC_SENTRY_DSN"
EXPO_PUBLIC_DEV_BYPASS_AUTH="false"
EXPO_PUBLIC_DEV_BYPASS_MAP_AUTH="false"
